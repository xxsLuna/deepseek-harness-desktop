{
  "name": "deepseek-harness-desktop",
  "version": "0.1.1-desktop-v0.2.5",
  "description": "Unofficial desktop app for DeepSeek Harness",
  "private": true,
  "license": "MIT",
  "author": "Luna <xxs.main@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xxsLuna/deepseek-harness-desktop.git"
  },
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "stage": "node scripts/stage-harness.mjs",
    "stage:local": "node scripts/stage-harness.mjs --local-only",
    "prune": "node scripts/prune-payload.mjs",
    "prune:dry": "node scripts/prune-payload.mjs --dry-run",
    "build": "tsc && node scripts/build-client.mjs && node scripts/stage-harness.mjs --local-only",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/connection && tsc --noEmit -p packages/settings && tsc --noEmit -p packages/market && tsc --noEmit -p packages/claude-plugins && tsc --noEmit -p packages/layout-memory",
    "dev": "npm run build && electron .",
    "smoke": "npm run build && DSH_DESKTOP_SMOKE=1 electron .",
    "test": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract --no-file-parallelism",
    "package": "electron-builder",
    "smoke:packaged": "node scripts/smoke-packaged.mjs"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "~18.3.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "semver": "^7.8.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "productName": "DeepSeek Harness"
}
